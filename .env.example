# OpenAI (optional - falls back to Anthropic, then the deterministic
# offline mock parser, if unset)
OPENAI_API_KEY=

# Anthropic (optional - used if OPENAI_API_KEY is not set)
ANTHROPIC_API_KEY=

# Optional OpenTelemetry OTLP collector export (e.g. Dynatrace, an OTel
# Collector). Spans are always captured in-memory for the Streamlit
# GovOps panel regardless of whether this is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
